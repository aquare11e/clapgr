#!/usr/bin/env bash
set -euo pipefail

CLAPGR_VERSION="0.1.0"

if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
    echo "clapgr $CLAPGR_VERSION"
    exit 0
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'HELP'
clapgr - Upgrade claude-code via Homebrew with release notes

Usage: clapgr [options]

Options:
  -h, --help       Show this help message
  -v, --version    Show version

clapgr upgrades claude-code, fetches release notes from GitHub,
and optionally summarizes them using the Claude CLI.
HELP
    exit 0
fi

LOG_DIR="${HOME}/.claude-upgrade-logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${LOG_DIR}/${TIMESTAMP}.log"

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

log() { printf '%b\n' "$1" | tee -a "$LOG_FILE"; }

# --- Check dependencies ---
if ! command -v jq &>/dev/null; then
    log "${RED}Error: jq is required but not installed. Run: brew install jq${RESET}"
    exit 1
fi

# --- Get current version ---
brew_version() {
    local ver
    ver=$(brew list --cask --versions claude-code 2>/dev/null | awk '{print $NF}')
    if [[ -z "$ver" ]]; then
        ver=$(brew list --versions claude-code 2>/dev/null | awk '{print $NF}')
    fi
    echo "$ver"
}
OLD_VERSION=$(brew_version)
if [[ -z "$OLD_VERSION" ]]; then
    log "${RED}Error: claude-code is not installed via brew.${RESET}"
    exit 1
fi
log "${CYAN}Current version: ${BOLD}${OLD_VERSION}${RESET}"

# --- Run brew upgrade ---
log "\n${YELLOW}Running brew upgrade claude-code...${RESET}"
brew upgrade claude-code 2>&1 | tee -a "$LOG_FILE" || true

# --- Get new version ---
NEW_VERSION=$(brew_version)

if [[ "$OLD_VERSION" == "$NEW_VERSION" ]]; then
    log "\n${GREEN}Already up to date: ${BOLD}${OLD_VERSION}${RESET}"
    exit 0
fi

log "\n${GREEN}${BOLD}claude-code ${OLD_VERSION} -> ${NEW_VERSION}${RESET}"
log "Update log saved to: ${LOG_FILE}\n"

# --- Fetch release notes from GitHub ---
log "${YELLOW}Fetching release notes...${RESET}\n"

RELEASES_JSON=$(curl -sL "https://api.github.com/repos/anthropics/claude-code/releases?per_page=50")

# Extract release notes for versions > OLD and <= NEW
NOTES=""
while IFS= read -r tag; do
    ver="${tag#v}"
    if [[ "$(printf '%s\n%s' "$OLD_VERSION" "$ver" | sort -V | head -1)" == "$OLD_VERSION" \
       && "$ver" != "$OLD_VERSION" \
       && "$(printf '%s\n%s' "$ver" "$NEW_VERSION" | sort -V | head -1)" == "$ver" ]]; then
        BODY=$(echo "$RELEASES_JSON" | jq -r --arg tag "$tag" '.[] | select(.tag_name == $tag) | .body // ""')
        if [[ -n "$BODY" ]]; then
            NOTES+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            NOTES+=$'\n'"Version ${ver}"$'\n'
            NOTES+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
            NOTES+="${BODY}"$'\n\n'
        fi
    fi
done < <(echo "$RELEASES_JSON" | jq -r '.[].tag_name')

if [[ -z "$NOTES" ]]; then
    log "${YELLOW}No release notes found for versions between ${OLD_VERSION} and ${NEW_VERSION}.${RESET}"
    log "${CYAN}Check: https://github.com/anthropics/claude-code/releases${RESET}"
else
    echo "$NOTES" >> "$LOG_FILE"

    # Summarize with claude if available
    if command -v claude &>/dev/null; then
        log "${YELLOW}Summarizing release notes with Claude...${RESET}\n"
        SUMMARY=$(echo "$NOTES" | claude -p "You are given release notes for claude-code updates from version ${OLD_VERSION} to ${NEW_VERSION}. Provide a concise summary with the most critical/breaking changes first, then notable new features, then bug fixes. Use bullet points. Keep it under 30 lines. Skip any marketing fluff." 2>/dev/null) || true
        if [[ -n "$SUMMARY" ]]; then
            log "${BOLD}${CYAN}═══ Summary: claude-code ${OLD_VERSION} → ${NEW_VERSION} ═══${RESET}\n"
            log "$SUMMARY"
            printf '\n--- Summary ---\n%s' "$SUMMARY" >> "$LOG_FILE"
        else
            log "${YELLOW}Could not generate summary. Raw notes:${RESET}\n"
            log "$NOTES"
        fi
    else
        log "${YELLOW}Claude CLI not found. Raw release notes:${RESET}\n"
        log "$NOTES"
    fi
fi

log "\n${GREEN}${BOLD}Update complete: claude-code ${OLD_VERSION} → ${NEW_VERSION}${RESET}"
log "Full log: ${LOG_FILE}"