#!/usr/bin/env bash
set -euo pipefail

CLAPGR_VERSION="0.2.0"

# Homebrew casks per release channel
CASK_STABLE="claude-code"
CASK_LATEST="claude-code@latest"

show_help() {
    cat <<'HELP'
clapgr - Upgrade claude-code via Homebrew with release notes

Usage: clapgr [options]

Options:
  -h, --help        Show this help message
  -v, --version     Show version
  --stable          Switch to the stable channel (Homebrew cask: claude-code)
  --latest          Switch to the latest channel (Homebrew cask: claude-code@latest)
  --channel <name>  Switch to a channel: stable | latest

With no channel option, clapgr upgrades whichever claude-code cask is
currently installed. A channel option swaps the Homebrew cask if needed
(uninstall the other, install the target), then upgrades.

After upgrading, clapgr fetches release notes from GitHub and optionally
summarizes them using the Claude CLI.

Note: nightly is not available via Homebrew. Install it with npm instead:
  npm install -g @anthropic-ai/claude-code@nightly
HELP
}

die() { printf 'Error: %s\n' "$1" >&2; exit 1; }

# --- Resolve channel from args ---
TARGET_CHANNEL=""   # "", "stable", or "latest"

set_channel() {
    case "$1" in
        stable|latest) TARGET_CHANNEL="$1" ;;
        nightly) die "nightly is not available via Homebrew. Use npm: npm install -g @anthropic-ai/claude-code@nightly" ;;
        *) die "unknown channel '$1' (valid: stable, latest)" ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--version) echo "clapgr $CLAPGR_VERSION"; exit 0 ;;
        -h|--help)    show_help; exit 0 ;;
        --stable)     set_channel stable;  shift ;;
        --latest)     set_channel latest;  shift ;;
        --nightly)    set_channel nightly ;;  # exits via die with npm hint
        --channel)
            shift
            [[ -n "${1:-}" ]] || die "--channel requires a name (stable | latest)"
            set_channel "$1"; shift ;;
        *) die "unknown option '$1' (see --help)" ;;
    esac
done

LOG_DIR="${HOME}/.claude-upgrade-logs"
mkdir -p "$LOG_DIR"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${LOG_DIR}/${TIMESTAMP}.log"

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

log() { printf '%b\n' "$1" | tee -a "$LOG_FILE"; }

# --- Check dependencies ---
if ! command -v jq &>/dev/null; then
    log "${RED}Error: jq is required but not installed. Run: brew install jq${RESET}"
    exit 1
fi

# --- Cask helpers ---
cask_version() {
    [[ -n "$1" ]] || return 0
    brew list --cask --versions "$1" 2>/dev/null | awk '{print $NF}' || true
}
cask_installed() { [[ -n "$(cask_version "$1")" ]]; }

# Which claude-code cask is currently installed (latest takes precedence)
installed_cask() {
    if cask_installed "$CASK_LATEST"; then echo "$CASK_LATEST"
    elif cask_installed "$CASK_STABLE"; then echo "$CASK_STABLE"
    else echo ""; fi
}
channel_cask() {
    case "$1" in
        stable) echo "$CASK_STABLE" ;;
        latest) echo "$CASK_LATEST" ;;
    esac
}

CUR_CASK=$(installed_cask)
SWITCHED=0

if [[ -n "$TARGET_CHANNEL" ]]; then
    TARGET_CASK=$(channel_cask "$TARGET_CHANNEL")
    OLD_VERSION=$(cask_version "$CUR_CASK")
    log "${CYAN}Current version: ${BOLD}${OLD_VERSION:-none}${RESET} ${CYAN}(cask: ${CUR_CASK:-none})${RESET}"
    log "${CYAN}Target channel:  ${BOLD}${TARGET_CHANNEL}${RESET} ${CYAN}(cask: ${TARGET_CASK})${RESET}"

    if [[ "$CUR_CASK" == "$TARGET_CASK" ]]; then
        log "\n${YELLOW}Already on ${TARGET_CHANNEL} channel. Running brew upgrade...${RESET}"
        brew upgrade --cask "$TARGET_CASK" 2>&1 | tee -a "$LOG_FILE" || true
    else
        SWITCHED=1
        if [[ -n "$CUR_CASK" ]]; then
            log "\n${YELLOW}Switching channel: ${CUR_CASK} -> ${TARGET_CASK}${RESET}"
            log "${YELLOW}Removing ${CUR_CASK}...${RESET}"
            brew uninstall --cask "$CUR_CASK" 2>&1 | tee -a "$LOG_FILE" || die "failed to uninstall ${CUR_CASK}"
        fi
        log "${YELLOW}Installing ${TARGET_CASK}...${RESET}"
        brew install --cask "$TARGET_CASK" 2>&1 | tee -a "$LOG_FILE" || die "failed to install ${TARGET_CASK}"
    fi
    ACTIVE_CASK="$TARGET_CASK"
else
    [[ -n "$CUR_CASK" ]] || { log "${RED}Error: claude-code is not installed via brew.${RESET}"; exit 1; }
    OLD_VERSION=$(cask_version "$CUR_CASK")
    log "${CYAN}Current version: ${BOLD}${OLD_VERSION}${RESET} ${CYAN}(cask: ${CUR_CASK})${RESET}"
    log "\n${YELLOW}Running brew upgrade ${CUR_CASK}...${RESET}"
    brew upgrade --cask "$CUR_CASK" 2>&1 | tee -a "$LOG_FILE" || true
    ACTIVE_CASK="$CUR_CASK"
fi

# --- Get new version ---
NEW_VERSION=$(cask_version "$ACTIVE_CASK")

if [[ "$OLD_VERSION" == "$NEW_VERSION" && "$SWITCHED" -eq 0 ]]; then
    log "\n${GREEN}Already up to date: ${BOLD}${OLD_VERSION}${RESET}"
    exit 0
fi

if [[ "$SWITCHED" -eq 1 ]]; then
    log "\n${GREEN}${BOLD}Switched to ${TARGET_CHANNEL} channel: claude-code ${OLD_VERSION:-none} -> ${NEW_VERSION}${RESET}"
else
    log "\n${GREEN}${BOLD}claude-code ${OLD_VERSION} -> ${NEW_VERSION}${RESET}"
fi
log "Update log saved to: ${LOG_FILE}\n"

# No prior version (fresh install via channel switch): skip the notes diff.
if [[ -z "$OLD_VERSION" ]]; then
    log "${YELLOW}Fresh install; skipping release-note diff.${RESET}"
    log "${CYAN}Release notes: https://github.com/anthropics/claude-code/releases${RESET}"
    log "\n${GREEN}${BOLD}Update complete: claude-code ${NEW_VERSION} (${TARGET_CHANNEL:-current} channel)${RESET}"
    log "Full log: ${LOG_FILE}"
    exit 0
fi

# --- Fetch release notes from GitHub ---
log "${YELLOW}Fetching release notes...${RESET}\n"

RELEASES_JSON=$(curl -sL "https://api.github.com/repos/anthropics/claude-code/releases?per_page=50")

# Extract release notes for versions > OLD and <= NEW
NOTES=""
while IFS= read -r tag; do
    ver="${tag#v}"
    if [[ "$(printf '%s\n%s' "$OLD_VERSION" "$ver" | sort -V | head -1)" == "$OLD_VERSION" \
       && "$ver" != "$OLD_VERSION" \
       && "$(printf '%s\n%s' "$ver" "$NEW_VERSION" | sort -V | head -1)" == "$ver" ]]; then
        BODY=$(echo "$RELEASES_JSON" | jq -r --arg tag "$tag" '.[] | select(.tag_name == $tag) | .body // ""')
        if [[ -n "$BODY" ]]; then
            NOTES+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            NOTES+=$'\n'"Version ${ver}"$'\n'
            NOTES+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
            NOTES+="${BODY}"$'\n\n'
        fi
    fi
done < <(echo "$RELEASES_JSON" | jq -r '.[].tag_name')

if [[ -z "$NOTES" ]]; then
    log "${YELLOW}No release notes found for versions between ${OLD_VERSION} and ${NEW_VERSION}.${RESET}"
    log "${CYAN}Check: https://github.com/anthropics/claude-code/releases${RESET}"
else
    echo "$NOTES" >> "$LOG_FILE"

    # Summarize with claude if available
    if command -v claude &>/dev/null; then
        log "${YELLOW}Summarizing release notes with Claude...${RESET}\n"
        SUMMARY=$(echo "$NOTES" | claude -p "You are given release notes for claude-code updates from version ${OLD_VERSION} to ${NEW_VERSION}. Provide a concise summary with the most critical/breaking changes first, then notable new features, then bug fixes. Use bullet points. Keep it under 30 lines. Skip any marketing fluff." 2>/dev/null) || true
        if [[ -n "$SUMMARY" ]]; then
            log "${BOLD}${CYAN}═══ Summary: claude-code ${OLD_VERSION} → ${NEW_VERSION} ═══${RESET}\n"
            log "$SUMMARY"
            printf '\n--- Summary ---\n%s' "$SUMMARY" >> "$LOG_FILE"
        else
            log "${YELLOW}Could not generate summary. Raw notes:${RESET}\n"
            log "$NOTES"
        fi
    else
        log "${YELLOW}Claude CLI not found. Raw release notes:${RESET}\n"
        log "$NOTES"
    fi
fi

log "\n${GREEN}${BOLD}Update complete: claude-code ${OLD_VERSION} → ${NEW_VERSION}${RESET}"
log "Full log: ${LOG_FILE}"